FROM node:22-slim
WORKDIR /juice-shop
RUN apt-get -o Acquire::ForceIPv4=true update && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*
COPY juice-shop-src/ .
RUN npm install
RUN npm run build:server
EXPOSE 3000
CMD ["node", "build/app.js"]
